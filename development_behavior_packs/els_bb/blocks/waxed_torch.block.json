{
	"format_version": "1.21.70",
	"minecraft:block": {
		"description": {
			"identifier": "els_bb:waxed_torch",
			"menu_category": {
				"category": "items",
				"group": "minecraft:itemGroup.name.torch"
			},
			"traits": {
				"minecraft:placement_position": {
					"enabled_states": ["minecraft:block_face"]
				}
			}
		},
		"components": {
			"minecraft:collision_box": false,
			"minecraft:selection_box": {
				"origin": [-1, 0, -1],
				"size": [2, 10, 2]
			},
			"minecraft:geometry": "geometry.waxed_torch",
			"minecraft:material_instances": {
				"*": {
					"texture": "els_bb:waxed_torch",
					"render_method": "alpha_test",
					"ambient_occlusion": false,
					"face_dimming": false
				}
			},
			"minecraft:light_emission": 14,
			"minecraft:light_dampening": 0,
			"minecraft:destructible_by_mining": {
				"seconds_to_destroy": 0
			},
			"minecraft:destructible_by_explosion": {
				"explosion_resistance": 0
			},
			"minecraft:loot": "loot_tables/blocks/waxed_torch.json",
			"minecraft:placement_filter": {
				"conditions": [
					{
						"allowed_faces": ["up", "side"]
					}
				]
			},
			"minecraft:custom_components": ["els_bb:waxed_torch_particles"],
			"minecraft:tick": {
				"interval_range": [8, 16],
				"looping": true
			}
		},
		"permutations": [
			{
				"condition": "q.block_state('minecraft:block_face') == 'north'",
				"components": {
					"minecraft:transformation": {
						"rotation": [0, 0, 0]
					}
				}
			},
			{
				"condition": "q.block_state('minecraft:block_face') == 'south'",
				"components": {
					"minecraft:transformation": {
						"rotation": [0, 180, 0]
					}
				}
			},
			{
				"condition": "q.block_state('minecraft:block_face') == 'west'",
				"components": {
					"minecraft:transformation": {
						"rotation": [0, 90, 0]
					}
				}
			},
			{
				"condition": "q.block_state('minecraft:block_face') == 'east'",
				"components": {
					"minecraft:transformation": {
						"rotation": [0, -90, 0]
					}
				}
			},
			{
				"condition": "q.block_state('minecraft:block_face') != 'up' && q.block_state('minecraft:block_face') != 'down'",
				"components": {
					"minecraft:collision_box": false,
					"minecraft:selection_box": {
						"origin": [-2, 3, 4],
						"size": [4, 10, 4]
					},
					"minecraft:geometry": "geometry.waxed_torch_wall"
				}
			}
		]
	}
}
