{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "ae:allay_hurt_sparkle",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/glowing_white"
      }
    },
    "curves": {
      "variable.size_scale": {
        "type": "linear",
        "input": "v.particle_age",
        "horizontal_range": "v.particle_lifetime",
        "nodes": [0.45, 1, 0.7, 0.25, 0]
      }
    },
    "components": {
      "minecraft:emitter_local_space": {
        "position": true
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 12
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.08,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.35, 0.55)"
      },
      "minecraft:particle_initial_speed": "math.random(0.7, 1.5)",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 4
      },
      "minecraft:particle_appearance_billboard": {
        "size": ["(0.55+v.particle_random_1)*0.1*v.size_scale", "(0.55+v.particle_random_1)*0.1*v.size_scale"],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [0, 0],
          "uv_size": [16, 16]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "variable.particle_age/variable.particle_lifetime",
          "gradient": {
            "0.0": "#FFFF4040",
            "0.4": "#FFCC1010",
            "1.0": "#00600000"
          }
        }
      }
    }
  }
}
