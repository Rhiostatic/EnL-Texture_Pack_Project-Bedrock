{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.ae.creeper.base": {
      "states": {
        "default": {
          "animations": [
            "creeper_head",
            "bob",
            "fire_particles"
          ]
        }
      }
    },
    "controller.animation.ae.creeper.walk": {
      "states": {
        "default": {
          "animations": [
            {
              "walk": "math.min(0.7,query.modified_move_speed)"
            }
          ],
          "blend_transition": 0.16,
          "transitions": [
            {
              "float": "q.is_in_water"
            },
            {
              "in_air": "!q.is_on_ground&&q.vertical_speed>1"
            }
          ]
        },
        "float": {
          "blend_transition": 0.2,
          "animations": [
            "float"
          ],
          "transitions": [
            {
              "default": "!q.is_in_water&&q.is_on_ground"
            }
          ]
        },
        "in_air": {
          "blend_transition": 0.12,
          "transitions": [
            {
              "float": "q.is_in_water"
            },
            {
              "default": "q.is_on_ground"
            }
          ]
        }
      }
    },
    "controller.animation.ae.creeper.swell": {
      "states": {
        "default": {
          "blend_transition": 0.16,
          "transitions": [
            {
              "swell": "query.swelling_dir==1"
            }
          ]
        },
        "swell": {
          "animations": [
            "creeper_swelling",
            "vibrate",
            {
              "shake": "2.4"
            }
          ],
          "blend_transition": 0.6,
          "transitions": [
            {
              "default": "query.swell_amount==0"
            }
          ]
        }
      }
    },
    "controller.animation.ae.creeper.boom": {
      "states": {
        "default": {
          "transitions": [
            {
              "charge": "query.swelling_dir==1"
            }
          ]
        },
        "charge": {
          "particle_effects": [
            {
              "effect": "charging",
              "locator": "trunk"
            },
            {
              "effect": "explosion_0",
              "locator": "trunk"
            },
            {
              "effect": "explosion_2",
              "locator": "trunk"
            },
            {
              "effect": "explosion_3"
            },
            {
              "effect": "explosion_4"
            }
          ],
          "transitions": [
            {
              "default": "query.swelling_dir==-1"
            }
          ]
        }
      }
    },
    "controller.animation.ae.creeper.in_air": {
      "states": {
        "default": {
          "animations": [
            "controller_land",
            "controller_jump",
            "controller_fall"
          ]
        }
      }
    },
    "controller.animation.ae.creeper.jump": {
      "states": {
        "default": {
          "transitions": [
            {
              "up": "!query.is_on_ground&&!query.is_in_water&&query.vertical_speed>0"
            }
          ]
        },
        "up": {
          "blend_transition": 0.24,
          "animations": [
            "jump"
          ],
          "transitions": [
            {
              "default": "query.is_on_ground||query.is_in_water||query.vertical_speed<0"
            }
          ]
        }
      }
    },
    "controller.animation.ae.creeper.fall": {
      "initial_state": "still",
      "states": {
        "still": {
          "transitions": [
            {
              "dn": "!query.is_on_ground&&query.vertical_speed<0"
            }
          ]
        },
        "dn": {
          "blend_transition": 0.26,
          "animations": [
            "fall",
            {
              "jump_timer": "q.is_on_ground"
            }
          ],
          "transitions": [
            {
              "still": "(query.is_on_ground&&q.any_animation_finished)||q.vertical_speed>=0.0"
            },
            {
              "splash": "query.is_in_water"
            }
          ]
        },
        "splash": {
          "particle_effects": [
            {
              "effect": "splash"
            },
            {
              "effect": "impact"
            },
            {
              "effect": "ripples"
            }
          ],
          "transitions": [
            {
              "still": "!query.is_in_water"
            }
          ]
        }
      }
    },
    "controller.animation.ae.creeper.land": {
      "states": {
        "default": {
          "blend_transition": 0.1,
          "animations": [
            "land"
          ],
          "transitions": [
            {
              "in_air": "!q.is_on_ground"
            }
          ]
        },
        "in_air": {
          "blend_transition": 0.06,
          "animations": [
            "vert_cap",
            {
              "jump_timer": "q.is_on_ground"
            }
          ],
          "transitions": [
            {
              "default": "q.is_on_ground&&q.all_animations_finished"
            }
          ]
        }
      }
    },
    "controller.animation.ae.creeper.on_fire": {
      "states": {
        "default": {
          "transitions": [
            {
              "on_fire": "q.is_on_fire"
            }
          ]
        },
        "on_fire": {
          "particle_effects": [
            {
              "effect": "fire"
            }
          ],
          "transitions": [
            {
              "combust": "!q.is_on_fire"
            }
          ]
        },
        "combust": {
          "particle_effects": [
            {
              "effect": "combust"
            }
          ],
          "transitions": [
            {
              "default": "1"
            }
          ]
        }
      }
    },
    "controller.animation.ae.creeper.rotate": {
      "states": {
        "default": {
          "on_entry": [
            "v.target_yaw=q.body_y_rotation;"
          ],
          "on_exit": [
            "v.target_yaw=q.body_y_rotation;"
          ],
          "transitions": [
            {
              "rot_right": "variable.body_rot>0"
            },
            {
              "rot_left": "variable.body_rot<0"
            }
          ]
        },
        "rot_right": {
          "animations": [
            {
              "rotate_right": "math.max(1-q.modified_move_speed*4,0)"
            }
          ],
          "transitions": [
            {
              "default": "q.any_animation_finished"
            },
            {
              "rot_left": "variable.body_rot<0"
            }
          ]
        },
        "rot_left": {
          "animations": [
            {
              "rotate_left": "math.max(1-q.modified_move_speed*4,0)"
            }
          ],
          "transitions": [
            {
              "default": "q.any_animation_finished"
            },
            {
              "rot_right": "variable.body_rot>0"
            }
          ]
        }
      }
    }
  }
}
