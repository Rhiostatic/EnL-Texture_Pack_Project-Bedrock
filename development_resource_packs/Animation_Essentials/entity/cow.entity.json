        "damage": "controller.animation.cow.v1.8.damage"
      },
      "scripts": {
        "pre_animation": [
          "t.variant = query.property('minecraft:climate_variant');",
          "v.index = (t.variant == 'temperate') ? 0 : ((t.variant == 'warm') ? 1 : 2);",
          "v.is_cold = t.variant == 'cold';",
          "variable.eye_target_x = query.target_y_rotation - this;",
          "variable.eye_target_y = query.target_x_rotation - this;"
        ],
        "animate": [
          "general",
          "facial",
          "look_target",
          "damage"
        ],
        "scale": "query.is_baby ? 2.0 : 1.0"
      },
      "render_controllers": [
        "controller.render.cow.v3"
      ],
      "spawn_egg": {
        "texture": "spawn_egg_cow"
      }
